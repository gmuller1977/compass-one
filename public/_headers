# Cabeçalhos na Cloudflare (29/10/2026). São os mesmos do vercel.json:
# enquanto as duas hospedagens existirem, mudar um é mudar o outro.
# A Vercel ignora este arquivo.
#
# Não há _redirects: o "rewrite para /" do vercel.json é o
# not_found_handling do wrangler.jsonc.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self)

# O nome dos arquivos de /assets muda a cada build.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O app.compass-one.com.br é o app (login e telas com dado), não página para o
# Google: só a apresentação no www entra na busca (11/11/2026).
https://app.compass-one.com.br/*
  X-Robots-Tag: noindex
