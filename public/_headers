# Cabeçalhos da Cloudflare Pages (29/10/2026). São os mesmos do vercel.json:
# enquanto as duas hospedagens existirem, mudar um é mudar o outro.
# A Vercel ignora este arquivo.
#
# Não há _redirects de propósito: sem um 404.html na raiz do dist, a Pages
# serve o index.html em qualquer endereço que não seja arquivo (o mesmo
# "rewrite para /" do vercel.json). Uma regra "/* /index.html 200" é
# recusada por ela como laço infinito.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self)

# O nome dos arquivos de /assets muda a cada build.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
